# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAWAN_API_KEY: Required for Pawan.Krd Kurdish Sorani TTS API calls.
# Can be set via environment secrets or overridden in the Studio Settings modal.
PAWAN_API_KEY="MY_PAWAN_API_KEY"

# PAWAN_API_KEY_FALLBACK: Optional backup Pawan.Krd key(s) (comma-separated for multiple) used automatically if the primary key hits a limit.
PAWAN_API_KEY_FALLBACK="MY_SECOND_PAWAN_API_KEY"
# PAWAN_API_KEYS: Optional comma-separated list of additional Pawan.Krd keys for automatic failover.
PAWAN_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
